generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id        String   @id
  tokenHash String
  lat       Float
  lng       Float
  vibe      String   @default("chat")
  peerId    String?
  pendingTo String?
  blocked   String[] @default([])
  lastSeen  DateTime

  @@index([lastSeen])
  @@index([peerId])
  @@index([pendingTo])
}

model Signal {
  id        String   @id @default(uuid())
  toId      String
  fromId    String
  type      String
  payload   String?
  createdAt DateTime @default(now())

  @@index([toId])
  @@index([createdAt])
}
